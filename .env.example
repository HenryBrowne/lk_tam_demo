# Portfolio Signal — environment configuration
# Copy to .env and fill in. .env is gitignored.

# =============================================================================
# LiveKit Cloud (free tier) — Project Settings > Keys
# =============================================================================
LIVEKIT_URL=wss://your-project-xxxxxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook receiver: the shared secret is the same LIVEKIT_API_KEY/SECRET pair
# above (LiveKit signs webhook JWTs with your project secret). Point your
# LiveKit project's webhook URL at:  http://<this-host>:8080/livekit/webhook
# For local dev, expose it with `lk` or a tunnel; see NOTES-livekit-api.md.
RECEIVER_HOST=0.0.0.0
RECEIVER_PORT=8080

# =============================================================================
# LLM — account brief generator (direct Anthropic SDK call, offline/batch)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BRIEF_LLM_MODEL=claude-sonnet-5

# =============================================================================
# Voice agent pipeline — STT -> LLM -> TTS
# Providers are swappable by changing these values. Defaults: Deepgram + Claude
# + Cartesia. To run "all-OpenAI" (one key) set:
#   AGENT_STT_PROVIDER=openai  AGENT_LLM_PROVIDER=openai  AGENT_TTS_PROVIDER=openai
# and provide OPENAI_API_KEY only.
# =============================================================================
AGENT_STT_PROVIDER=deepgram        # deepgram | openai
AGENT_LLM_PROVIDER=anthropic       # anthropic | openai
AGENT_TTS_PROVIDER=cartesia        # cartesia | openai

# Agent LLM model. Default claude-haiku-4-5: low latency, and compatible with
# livekit-plugins-anthropic 1.7.1's prefill handling (see NOTES-livekit-api.md).
AGENT_LLM_MODEL=claude-haiku-4-5

DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CARTESIA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed if you switch any AGENT_*_PROVIDER to "openai", or for the
# all-OpenAI fallback path.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Storage
# =============================================================================
PORTFOLIO_DB=data/portfolio.db

# =============================================================================
# Account tagging — rooms are mapped to a synthetic account via room metadata
# {"account_id": "..."}; this prefix is the identity-based fallback when a room
# has no such metadata (e.g. "acct-globex__user-42" -> "globex").
# =============================================================================
ACCOUNT_IDENTITY_PREFIX_SEP=__
